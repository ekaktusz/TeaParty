; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Fall Cozy Jam"
run/main_scene="res://scenes/menu_scene.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

BgMusic="*res://bg_music.tscn"
SceneTransition="*res://scene_transition.tscn"
CustomerDatabase="*res://customer_database.gd"
SelectedIngredient="*res://selected_ingredients.gd"
UnlockDatabase="*res://unlock_database.gd"
BgNoises="*res://bg_noises.tscn"
SteamSound="*res://steam_sound.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
